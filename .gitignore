# Downloaded corpus and derived data — reproducible via `usuk fetch` / `usuk index`
corpus/raw/
corpus/text/
data/

# Secrets
.env

# Python
.venv/
__pycache__/
*.egg-info/
.pytest_cache/

# Excel lock files
~$*.xlsx

# Personal workbooks with real figures stay out of git; the blank template
# (spreadsheets/template_*.xlsx) is tracked.
spreadsheets/*.xlsx
!spreadsheets/template_*.xlsx

# Claude Code local settings
.claude/settings.local.json*
